rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read for settings, products, branches, categories
    match /settings/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    match /products/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    match /categories/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    match /branches/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    // Public write for franchise applications and contact messages
    match /franchise_applications/{document=**} {
      allow create: if true;
      allow read, update, delete: if true;
    }
    match /contact_messages/{document=**} {
      allow create: if true;
      allow read, update, delete: if true;
    }
  }
}
